<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	version="6.0">
	<display-name>ApplicationScope</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

	<context-param>
		<param-name>db-ip</param-name>
		<param-value>127.0.0.1</param-value>
	</context-param>
	<context-param>
		<param-name>db-port</param-name>
		<param-value>3306</param-value>
	</context-param>

	<servlet>
		<servlet-name>ContextParam</servlet-name>
		<servlet-class>com.applicationscope.servlets.ContextParam</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>ContextParam</servlet-name>
		<url-pattern>/ContextParam</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>ApplicationScopeServlet1</servlet-name>
		<servlet-class>com.applicationscope.servlets.ApplicationScopeServlet1</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>ApplicationScopeServlet1</servlet-name>
		<url-pattern>/ApplicationScopeServlet1</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>ApplicationScopeServlet2</servlet-name>
		<servlet-class>com.applicationscope.servlets.ApplicationScopeServlet2</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>ApplicationScopeServlet2</servlet-name>
		<url-pattern>/ApplicationScopeServlet2</url-pattern>
	</servlet-mapping>
	
	
	<servlet>
		<servlet-name>SessionScope</servlet-name>
		<servlet-class>com.sessionscope.servlets.SessionScope</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>SessionScope</servlet-name>
		<url-pattern>/SessionScope</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>FormPageServlet</servlet-name>
		<servlet-class>com.requestscope.servlets.FormPageServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>FormPageServlet</servlet-name>
		<url-pattern>/formRequestPage</url-pattern>
	</servlet-mapping>
</web-app>